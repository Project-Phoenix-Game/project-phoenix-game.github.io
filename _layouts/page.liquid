---
layout: default
---
<article {% if page.feature-img or page.layout == 'tags' or page.layout == 'categories' or page.gallery_path %}class="{% if page.feature-img %}feature-image{% endif %}{% if page.layout == 'tags' %}{% unless page.feature-img %}tags-page{% else %} tags-page{% endunless %}{% endif %}{% if page.layout == 'categories' %}{% unless page.feature-img and page.layout == 'tags' %} categories-page{% else %} categories-page{% endunless %}{% endif %}{% if page.gallery_path %} gallery-page{% endif %}"{% endif %}>
    <header id="main" style="background-image: url('{{ page.feature-img | relative_url }}')">
        <div class="title-padder">
            {% if page.hide_title %}
                <div class="feature-image-padding"></div>
            {% else %}
                <h1 id="{{ page.title | default: "" | cgi_escape }}" class="title"> {{ page.title }}</h1>
                {% if page.subtitle %}
                    <h2 class="subtitle">{{ page.subtitle }}</h2>
                {% endif %}
            {% endif %}
        </div>
    </header>
    <section class="post-content{% if page.url == '/about/' %} about-centered{% endif %}">
    {% if page.bootstrap %}
        <div class="bootstrap-iso">
            {% endif %}
            {{ content }}
            {% if page.bootstrap %}
        </div>
        {% endif %}
    </section>
    {% unless page.layout == 'tags' %}
    <!-- Category and Tag list -->
    <div class="tag-category-container">
        <!-- Category list -->
        {% capture category_list %}{{ page.categories | join: "|" }}{% endcapture %}
        {% include default/category_list.liquid categories=category_list %}

        <!-- Tag list for portfolio -->
        {% capture tag_list %}{{ page.tags | join: "|" }}{% endcapture %}
        {% include default/tags_list.liquid tags=tag_list %}
    </div>
    {% endunless %}
</article>

---
layout: default
---
<article class="{% if page.layout == 'tags' %}tags-page{% elsif page.layout == 'categories' %}categories-page{% elsif page.gallery_path %}gallery-page{% else %}page-feature{% endif %}">
    <header id="main" class="hero">
        <div class="hero-bg" style="background-image: url('{{ page.feature-img | default: site.header_feature_image | relative_url }}')"></div>
        <div class="title-padder">
            {% if page.hide_title %}
                <div class="feature-image-padding"></div>
            {% else %}
                <h1 id="{{ page.title | default: "" | cgi_escape }}" class="title"> {{ page.title }}</h1>
                {% if page.subtitle %}
                    <h2 class="subtitle">{{ page.subtitle }}</h2>
                {% endif %}
            {% endif %}
        </div>
    </header>
    <section class="post-content{% if page.url == '/about/' %} about-centered{% endif %}">
    {% if page.bootstrap %}
        <div class="bootstrap-iso">
            {% endif %}
            {{ content }}
            {% if page.bootstrap %}
        </div>
        {% endif %}
    </section>
</article>
